# nginx configuration for PyBlog on a single internet-facing VPS.
#
# Architecture: nginx serves the static site (output/) directly, and
# proxies ONLY the administration routes to the PyBlog server, which
# listens on localhost. Visitors never touch the Python process; the
# admin area is reachable, but always over HTTPS and rate-limited.
#
# Copy to /etc/nginx/sites-available/blog, enable with a symlink, then:
#   sudo apt install certbot python3-certbot-nginx
#   sudo certbot --nginx -d mysite.com -d www.mysite.com
# certbot rewrites this file adding HTTPS and the HTTP->HTTPS redirect.

# Slows down password guessing on the login page: at most 1 request
# per second per IP, with a small burst allowance.
limit_req_zone $binary_remote_addr zone=pyblog_login:10m rate=1r/s;
# The newsletter's forms: a few requests a minute per address are plenty.
limit_req_zone $binary_remote_addr zone=pyblog_newsletter:10m rate=6r/m;

server {
    listen 80;
    server_name mysite.com www.mysite.com;

    root /path/to/pyblog/output;
    index index.html;

    access_log /var/log/nginx/blog-access.log;
    error_log  /var/log/nginx/blog-error.log;

    # --- Administration: proxied to the PyBlog server on localhost ---
    # Every dynamic route of the editor, in one place. Everything else
    # is served as static files.
    location ~ ^/(admin|edit|config|login|logout|change-password|preview|export|save|delete|toggle-status|save-config|save-config-raw|rebuild|upload|import-docx|translate|generate-description|generate-preview|analyze-seo|admin-language|set-password|scegli-punto|versioni|versione|newsletter-prova|newsletter-rimuovi|newsletter-iscritti\.csv)$ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        # The visitor's real address. PyBlog uses it to lock out only the
        # address that keeps getting the password wrong: without it every
        # request looks like 127.0.0.1 and one visitor could lock out all.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # PyBlog uses this to add the Secure flag to the session cookie.
        proxy_set_header X-Forwarded-Proto $scheme;
        # The AI analysis and translations can take up to a minute.
        proxy_read_timeout 120s;
        # Uploaded videos reach 100 MB, the same cap PyBlog applies; a Word
        # document to import, up to 30 MB.
        client_max_body_size 100m;
    }

    # The stylesheet and the script of the administration pages. They live
    # in PyBlog's static/ folder, not in output/, so they must reach Python
    # too. "^~" matters: without it the regex for static files below would
    # catch admin.css and admin.js first, look for them in output/ and answer
    # 404, and the admin would load with no style and no JavaScript.
    location ^~ /admin-static/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The newsletter's public forms: subscribing, confirming, leaving. They
    # are for readers, so they reach Python too, with a limit of their own.
    location ~ ^/(iscriviti|conferma|disiscrivi)$ {
        limit_req zone=pyblog_newsletter burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The login gets the rate limit on top.
    location = /login {
        limit_req zone=pyblog_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- Public site: static files, no Python involved ---
    location / {
        try_files $uri $uri/ =404;
    }

    # A missing page shows the site's own 404 page (with the search and the
    # latest articles) instead of nginx's bare one.
    error_page 404 /404.html;

    location ~* \.(css|js|jpg|jpeg|png|gif|ico|svg|woff2)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location = /rss.xml {
        default_type application/rss+xml;
    }

    location = /llms.txt {
        default_type text/plain;
    }

    # Uploaded media. nginx natively handles Range requests,
    # essential for video streaming and seeking.
    location /media/ {
        add_header Cache-Control "public, max-age=2592000";
    }
}
